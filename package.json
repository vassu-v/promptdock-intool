{
  "name": "promptdock",
  "productName": "PromptDock",
  "version": "0.1.0",
  "description": "A translucent always-on-top prompt library for Windows: search, compose, fill slots, paste.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "vassu-v",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --win dir"
  },
  "dependencies": {
    "sql.js": "1.15.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "onnxruntime-node@1.30.0": true
  }
}
