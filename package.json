{
  "name": "promptdock",
  "productName": "PromptDock",
  "version": "0.2.0",
  "description": "A translucent always-on-top prompt library for Windows: search, compose, fill slots, paste.",
  "type": "module",
  "main": "src/main/main.js",
  "author": "vassu-v",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win",
    "pack": "electron-builder --win dir",
    "test:e2e": "node test/e2e/run.js",
    "icon": "electron scripts/make-icon.cjs",
    "postinstall": "node scripts/ensure-electron.cjs"
  },
  "dependencies": {
    "sql.js": "1.15.0"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "4.3.1"
  },
  "devDependencies": {
    "electron": "44.8.0",
    "electron-builder": "26.15.3"
  },
  "allowScripts": {
    "electron@44.8.0": true,
    "onnxruntime-node@1.30.0": true
  },
  "build": {
    "appId": "com.vassu.promptdock",
    "productName": "PromptDock",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "build/*.png",
      "package.json",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/{linux,darwin}/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/x64/{DirectML.dll,dxcompiler.dll,dxil.dll}",
      "!**/node_modules/@huggingface/transformers/dist/*.web*",
      "!**/node_modules/@huggingface/transformers/dist/*.min.*",
      "!**/node_modules/@huggingface/transformers/dist/ort-*",
      "!**/node_modules/@huggingface/transformers/src/**",
      "!**/*.map",
      "!**/*.d.ts"
    ],
    "asarUnpack": [
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "PromptDock",
      "artifactName": "PromptDock-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PromptDock-Portable-${version}.exe"
    },
    "compression": "maximum"
  }
}
